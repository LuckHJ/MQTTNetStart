<Window x:Class="CabinetFaceWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小橘桌宠"
        Width="190"
        Height="230"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        PreviewMouseDown="Pet_PreviewMouseDown"
        MouseLeftButtonDown="Pet_MouseLeftButtonDown">
    <Grid Background="Transparent" ToolTip="右键打开桌宠菜单">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="拍照上传..." Click="OpenCameraMenu_Click"/>
                <MenuItem Header="数独" Click="OpenSudokuMenu_Click"/>
                <Separator/>
                <MenuItem Header="退出桌宠" Click="ExitMenu_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Viewbox Width="176" Height="210" VerticalAlignment="Top">
            <Image x:Name="GifPlayer" Width="176" Height="210" Stretch="Uniform"/>
        </Viewbox>

        <TextBlock Text="小橘 · 右键打开菜单"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,2"
                   Foreground="#70452F"
                   FontSize="12"
                   FontWeight="SemiBold"/>
    </Grid>
</Window>
