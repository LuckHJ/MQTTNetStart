<Window x:Class="CabinetFaceWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CabinetFaceWpf"
        mc:Ignorable="d"
        Title="摄像头预览" Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A8FE3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDefault" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D93F30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#A02015"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#333" Margin="8,8,8,4" CornerRadius="4">
            <Grid>
                <Image x:Name="imgCamera" Stretch="Uniform"/>
                <TextBlock x:Name="txtPlaceholder"
                           Text="摄像头未开启"
                           Foreground="#888" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border x:Name="snapBadge"
                        Background="#E8A200" CornerRadius="3" Padding="8,3"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="12" Visibility="Collapsed">
                    <TextBlock Text="已抓拍 - 选择操作" Foreground="#1E1E1E"
                               FontSize="13" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2D2D2D" Margin="8,4,8,8" Padding="8" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ledStatus" Width="12" Height="12" Fill="#555" Margin="4,0,6,0"/>
                    <TextBlock x:Name="txtStatus" Text="就绪" Foreground="#AAA" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnStart" Content="打开" Click="BtnStart_Click"
                            Width="72" Height="32" Margin="0,0,6,0"
                            Style="{StaticResource BtnPrimary}"/>
                    <Button x:Name="btnStop" Content="关闭" Click="BtnStop_Click"
                            Width="72" Height="32" Margin="0,0,6,0"
                            Style="{StaticResource BtnDefault}"/>
                    <Button x:Name="btnSnap" Content="抓拍" Click="BtnSnap_Click"
                            Width="72" Height="32" Margin="0,0,6,0"
                            Style="{StaticResource BtnDefault}"/>
                    <Button x:Name="btnSave" Content="保存" Click="BtnSave_Click"
                            Width="72" Height="32" Margin="0,0,6,0"
                            Style="{StaticResource BtnDefault}" Visibility="Collapsed"/>
                    <Button x:Name="btnUpload" Content="上传" Click="BtnUpload_Click"
                            Width="72" Height="32" Margin="0,0,6,0"
                            Style="{StaticResource BtnPrimary}" Visibility="Collapsed"/>
                    <Button x:Name="btnDiscard" Content="丢弃" Click="BtnDiscard_Click"
                            Width="72" Height="32"
                            Style="{StaticResource BtnDanger}" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>